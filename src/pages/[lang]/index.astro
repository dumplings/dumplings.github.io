---
import type { GetStaticPaths } from "astro";
import {
  createHomeStaticPaths,
  loadSiteBuildContext,
} from "../../lib/i18n/build.ts";
import type { HomePageProps } from "../../lib/i18n/build.ts";
import { languageHref } from "../../lib/i18n/urls.ts";

export const getStaticPaths = (async () => {
  const context = await loadSiteBuildContext();
  return createHomeStaticPaths(context);
}) satisfies GetStaticPaths;

type Props = HomePageProps;
const { manifest, language, content } = Astro.props;
---

<!doctype html>
<html lang={language.strapiLocale} dir={language.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{content.headline}</title>
  </head>
  <body>
    <nav aria-label="Languages">
      <ul>
        {manifest.languages.map((entry) => (
          <li>
            <a
              href={languageHref(import.meta.env.BASE_URL, entry.urlSegment)}
              lang={entry.strapiLocale}
              dir={entry.direction}
              aria-current={
                entry.urlSegment === language.urlSegment ? "page" : undefined
              }
            >
              {entry.strapiLocale}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <main>
      <h1>{content.headline}</h1>
      <p id="description">{content.description}</p>
      <dl>
        <dt>Site</dt>
        <dd>{manifest.siteId}</dd>
        <dt>CMS Locale</dt>
        <dd>{language.strapiLocale}</dd>
        <dt>URL segment</dt>
        <dd>{language.urlSegment}</dd>
        <dt>Direction</dt>
        <dd>{language.direction}</dd>
      </dl>
    </main>
  </body>
</html>
