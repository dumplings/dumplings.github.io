---
import type { GetStaticPaths } from "astro";
import { loadHomeBuildData } from "../../lib/i18n/build.ts";
import type { HomePageProps } from "../../lib/i18n/build.ts";
import { languageHref } from "../../lib/i18n/urls.ts";

export const getStaticPaths = (async () => {
  return (await loadHomeBuildData()).paths;
}) satisfies GetStaticPaths;

type Props = HomePageProps;
const { manifest, language, content, translation } = Astro.props;
---

<!doctype html>
<html lang={language.strapiLocale} dir={language.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title
      lang={content.headline.sourceLocale ?? language.strapiLocale}
    >{content.headline.value}</title>
  </head>
  <body>
    <nav aria-label="Languages">
      <ul>
        {manifest.languages.map((entry) => (
          <li>
            <a
              href={languageHref(import.meta.env.BASE_URL, entry.urlSegment)}
              lang={entry.strapiLocale}
              dir={entry.direction}
              aria-current={
                entry.urlSegment === language.urlSegment ? "page" : undefined
              }
            >
              {entry.strapiLocale}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <main
      data-entry-missing={String(translation.entryMissing)}
      data-mixed-language={String(translation.mixedLanguage)}
    >
      <h1
        lang={content.headline.sourceLocale ?? language.strapiLocale}
        data-source-locale={content.headline.sourceLocale}
        data-fallback={String(content.headline.fallback)}
        data-fallback-reason={content.headline.reason ?? undefined}
      >
        {content.headline.value}
      </h1>
      {content.description.value !== null && (
        <p
          id="description"
          lang={content.description.sourceLocale ?? language.strapiLocale}
          data-source-locale={content.description.sourceLocale}
          data-fallback={String(content.description.fallback)}
          data-fallback-reason={content.description.reason ?? undefined}
        >
          {content.description.value}
        </p>
      )}
      <dl>
        <dt>Site</dt>
        <dd>{manifest.siteId}</dd>
        <dt>CMS Locale</dt>
        <dd>{language.strapiLocale}</dd>
        <dt>URL segment</dt>
        <dd>{language.urlSegment}</dd>
        <dt>Direction</dt>
        <dd>{language.direction}</dd>
      </dl>
    </main>
  </body>
</html>
