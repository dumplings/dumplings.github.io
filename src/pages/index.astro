---
import SeoHead from "../components/SeoHead.astro";
import { loadSiteBuildContext } from "../lib/i18n/build.ts";
import { languageHref } from "../lib/i18n/urls.ts";

const { manifest } = await loadSiteBuildContext();
const language = manifest.defaultLanguage;
const target = languageHref(import.meta.env.BASE_URL, language.urlSegment);
---

<!doctype html>
<html lang={language.strapiLocale} dir={language.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <SeoHead
      title="English entry"
      description="Continue to the English homepage."
      canonicalPath={target}
      entry
    />
  </head>
  <body>
    <main>
      <h1>English entry</h1>
      <p>
        <a href={target}>Continue in English</a>
      </p>
    </main>
  </body>
</html>
